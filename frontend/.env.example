# CloudMentor frontend API target examples
#
# This file is a local reference only. It is never read by AWS Amplify.
# Amplify Hosting builds the frontend from an environment variable configured
# in the Amplify Console (App settings -> Environment variables), not from
# a committed .env file. See README section "Create the AWS Amplify app".

# 1) Local laptop mode against `npm run dev` in backend/ (local-server.mjs)
VITE_API_BASE_URL=http://localhost:3000

# 2) Production value, for reference only.
# Set the real value as an Amplify Console environment variable named
# VITE_API_BASE_URL, using the api_base_url output from `terraform apply`
# (also printed in the GitHub Actions job summary).
# VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com
